# Replay and shadow are the offline-safe defaults. No key is required.
MODEL_MODE=replay
WRITE_MODE=shadow
RUNTIME_ENVIRONMENT=local_sandbox
KILL_SWITCH=false

LLM_PROVIDER=gemini

# Live mode is optional and synthetic-data-only. Set MODEL_MODE=live and
# provide all three values explicitly; mutable "*-latest" aliases are not used.
GOOGLE_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
GEMINI_SCREENING_MODEL=gemini-2.5-flash-lite

CODE_VERSION=task-b
PROMPT_VERSION=prompt-v1
POLICY_VERSION=policy-v1
